{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run betterR extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=reditorsupport.r",
        "${workspaceFolder}/test-fixtures/workspace"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
