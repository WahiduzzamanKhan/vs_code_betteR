{
  "name": "better-vscode",
  "displayName": "betteR",
  "description": "One live R session (ark) shared by the terminal console, the editor, the debugger and a plot pane. No R packages installed into your project.",
  "version": "0.1.0",
  "publisher": "better",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:r"
  ],
  "contributes": {
    "commands": [
      {
        "command": "betteR.openConsole",
        "title": "Open R Console",
        "category": "betteR"
      },
      {
        "command": "betteR.showPlots",
        "title": "Show Plots",
        "category": "betteR"
      },
      {
        "command": "betteR.clearPlots",
        "title": "Clear All Plots",
        "category": "betteR"
      },
      {
        "command": "betteR.showViewer",
        "title": "Show Viewer",
        "category": "betteR"
      },
      {
        "command": "betteR.helpAtCursor",
        "title": "Help for Symbol at Cursor",
        "category": "betteR"
      },
      {
        "command": "betteR.runSelection",
        "title": "Run Selection or Line in R Console",
        "category": "betteR"
      },
      {
        "command": "betteR.restart",
        "title": "Restart R Session",
        "category": "betteR"
      }
    ],
    "keybindings": [
      {
        "command": "betteR.runSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == r"
      },
      {
        "command": "betteR.helpAtCursor",
        "key": "f1",
        "when": "editorTextFocus && editorLangId == r"
      }
    ],
    "configuration": {
      "title": "betteR",
      "properties": {
        "betteR.arkPath": {
          "type": "string",
          "default": "",
          "description": "Optional: a separate ark binary to run R instead of the kernel built into `better`. Leave empty to use the built-in kernel."
        },
        "betteR.consolePath": {
          "type": "string",
          "default": "",
          "description": "Path to the better binary (console and built-in R kernel). Empty: `better` on PATH, then ../betteR/target/debug/better."
        },
        "betteR.openConsoleOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Open the R console in a terminal when the session starts."
        }
      }
    },
    "debuggers": [
      {
        "type": "ark",
        "label": "R (ark)",
        "languages": [
          "r"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "r"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "npm run compile && vsce package --allow-missing-repository --skip-license -o better-vscode.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
  }
}
