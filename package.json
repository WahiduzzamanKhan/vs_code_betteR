{
  "name": "better-vscode",
  "displayName": "betteR",
  "description": "One live R session (ark) shared by the terminal console, the editor, the debugger and a plot pane. No R packages installed into your project.",
  "version": "0.2.0",
  "publisher": "better",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WahiduzzamanKhan/vs_code_betteR.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:r"
  ],
  "contributes": {
    "commands": [
      {
        "command": "betteR.openConsole",
        "title": "Open R Console",
        "category": "betteR"
      },
      {
        "command": "betteR.showPlots",
        "title": "Show Plots",
        "category": "betteR"
      },
      {
        "command": "betteR.clearPlots",
        "title": "Clear All Plots",
        "category": "betteR"
      },
      {
        "command": "betteR.showViewer",
        "title": "Show Viewer",
        "category": "betteR"
      },
      {
        "command": "betteR.helpAtCursor",
        "title": "Help for Symbol at Cursor",
        "category": "betteR"
      },
      {
        "command": "betteR.runSelection",
        "title": "Run Selection or Line in R Console",
        "category": "betteR"
      },
      {
        "command": "betteR.restart",
        "title": "Restart R Session",
        "category": "betteR"
      },
      {
        "command": "betteR.env.refresh",
        "title": "Refresh R Environment",
        "category": "betteR",
        "icon": "$(refresh)"
      },
      {
        "command": "betteR.env.clear",
        "title": "Clear R Environment",
        "category": "betteR",
        "icon": "$(clear-all)"
      },
      {
        "command": "betteR.env.filter",
        "title": "Filter Objects by Name",
        "category": "betteR",
        "icon": "$(search)"
      },
      {
        "command": "betteR.env.clearFilter",
        "title": "Clear Filter",
        "category": "betteR",
        "icon": "$(search-stop)"
      },
      {
        "command": "betteR.env.showHidden",
        "title": "Show Hidden Objects",
        "category": "betteR",
        "icon": "$(eye)"
      },
      {
        "command": "betteR.env.hideHidden",
        "title": "Hide Hidden Objects",
        "category": "betteR",
        "icon": "$(eye-closed)"
      },
      {
        "command": "betteR.env.remove",
        "title": "Remove Object",
        "category": "betteR",
        "icon": "$(trash)"
      },
      {
        "command": "betteR.env.viewData",
        "title": "View Data",
        "category": "betteR",
        "icon": "$(table)"
      },
      {
        "command": "betteR.env.print",
        "title": "Print in Console",
        "category": "betteR",
        "icon": "$(play)"
      },
      {
        "command": "betteR.env.str",
        "title": "Show Structure (str) in Console",
        "category": "betteR"
      },
      {
        "command": "betteR.env.copy",
        "title": "Copy",
        "category": "betteR"
      }
    ],
    "keybindings": [
      {
        "command": "betteR.runSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == r"
      },
      {
        "command": "betteR.helpAtCursor",
        "key": "f1",
        "when": "editorTextFocus && editorLangId == r"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "shift+enter",
        "args": {
          "text": "\u001b\r"
        },
        "when": "terminalFocus && betteR.consoleFocused && config.betteR.console.editing.newline != alt_enter && config.betteR.console.editing.newline != opt_enter"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "shift+enter",
        "args": {
          "text": "\r"
        },
        "when": "terminalFocus && betteR.consoleFocused && config.betteR.console.editing.newline =~ /^(alt|opt)_enter$/"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+enter",
        "args": {
          "text": "\u001b\r"
        },
        "when": "terminalFocus && betteR.consoleFocused && config.betteR.console.editing.newline =~ /^(alt|opt)_enter$/"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "alt+enter",
        "args": {
          "text": "\r"
        },
        "when": "terminalFocus && betteR.consoleFocused && config.betteR.console.editing.newline != alt_enter && config.betteR.console.editing.newline != opt_enter"
      },
      {
        "command": "betteR.env.filter",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "focusedView == betteR.environment"
      }
    ],
    "configuration": {
      "title": "betteR",
      "properties": {
        "betteR.arkPath": {
          "type": "string",
          "default": "",
          "description": "Optional: a separate ark binary to run R instead of the kernel built into `better`. Leave empty to use the built-in kernel."
        },
        "betteR.consolePath": {
          "type": "string",
          "default": "",
          "description": "Path to the better binary (console and built-in R kernel); `better.exe` on Windows. Empty: `better` (`better.exe` on Windows) on PATH, then ../betteR/target/debug/better."
        },
        "betteR.openConsoleOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Open the R console in a terminal when the session starts."
        },
        "betteR.console.startup.r_home": {
          "type": "string",
          "default": "",
          "markdownDescription": "R installation to use (its `R_HOME`). Empty: `$R_HOME`, else `R RHOME`. Used by the R kernel, unless `#betteR.arkPath#` is set. Changes apply when the R session restarts. Left unset, the console's `config.toml` decides.",
          "order": 10
        },
        "betteR.console.startup.banner": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the R version / ark / key-hint lines when the console starts. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 11
        },
        "betteR.console.startup.inline_plots": {
          "type": "string",
          "enum": [
            "auto",
            "iterm",
            "kitty",
            "sixel",
            "none"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Detect the terminal.",
            "iTerm2 inline images.",
            "Kitty graphics protocol.",
            "Sixel graphics.",
            "Don't draw plots in the terminal."
          ],
          "markdownDescription": "How plots are drawn in the terminal. `auto` detects the terminal. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 12
        },
        "betteR.console.completion.lsp": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Completions from ark's language server. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 13
        },
        "betteR.console.completion.popup": {
          "type": "string",
          "enum": [
            "typing",
            "tab"
          ],
          "default": "typing",
          "enumDescriptions": [
            "Show suggestions as you type.",
            "Show suggestions only when Tab is pressed."
          ],
          "markdownDescription": "Show completion suggestions as you type, or only when Tab is pressed. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 14
        },
        "betteR.console.completion.min_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3,
          "markdownDescription": "Only with `#betteR.console.completion.popup#` set to `typing`: name characters typed before the cursor before suggestions show. After `$`, `@` or `::`, suggestions always show, whatever this is set to. Ignored with `popup` set to `tab`. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 15
        },
        "betteR.console.completion.delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "default": 0,
          "markdownDescription": "Only with `#betteR.console.completion.popup#` set to `typing`: how long typing must pause (milliseconds) before suggestions show. Each key press restarts the wait. Ignored with `popup` set to `tab`. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 16
        },
        "betteR.console.completion.accept": {
          "type": "string",
          "enum": [
            "tab",
            "enter"
          ],
          "default": "tab",
          "enumDescriptions": [
            "Tab takes the highlighted suggestion.",
            "Enter takes the highlighted suggestion when the menu is open and runs the line when it isn't; Tab still opens the menu and moves to the next item."
          ],
          "markdownDescription": "Key that takes the highlighted completion suggestion. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 17
        },
        "betteR.console.completion.max_suggestions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 5,
          "markdownDescription": "Most suggestions shown at once in the completion menu (the border isn't counted). With more matches, the menu scrolls. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 18
        },
        "betteR.console.editing.newline": {
          "type": "string",
          "enum": [
            "auto",
            "shift_enter",
            "alt_enter",
            "opt_enter"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Shift+Enter in VS Code. (In other terminals: Shift+Enter where it can be told apart from Enter, else Alt+Enter.)",
            "Shift+Enter inserts a newline.",
            "Alt+Enter (Option+Enter on macOS) inserts a newline.",
            "Option+Enter on macOS; on Windows and Linux, the same as `alt_enter`."
          ],
          "markdownDescription": "The one key that inserts a newline in the R console; the others run the line like Enter. In VS Code the extension binds the chosen key itself, so it works whatever `#terminal.integrated.macOptionIsMeta#` and the kitty keyboard protocol are set to. The new key takes effect at once; the console's banner names it after a restart. Left unset, VS Code uses Shift+Enter and the console's `config.toml` decides the rest.",
          "order": 19
        },
        "betteR.console.history.size": {
          "type": "integer",
          "minimum": 0,
          "default": 10000,
          "markdownDescription": "Lines kept in the history file. `0` keeps no history. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 20
        },
        "betteR.console.history.suggestions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Fish-style suggestion: the rest of a matching history line in grey after the cursor; Right arrow takes it. Changes apply when the R console restarts. Left unset, the console's `config.toml` decides.",
          "order": 21
        }
      }
    },
    "debuggers": [
      {
        "type": "ark",
        "label": "R (ark)",
        "languages": [
          "r"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "r"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "betteR",
          "title": "R Session",
          "icon": "$(symbol-variable)"
        }
      ]
    },
    "views": {
      "betteR": [
        {
          "id": "betteR.environment",
          "name": "Environment",
          "icon": "$(symbol-variable)"
        },
        {
          "id": "betteR.searchPath",
          "name": "Attached",
          "icon": "$(package)"
        },
        {
          "id": "betteR.namespaces",
          "name": "Loaded Namespaces",
          "icon": "$(library)",
          "visibility": "collapsed"
        },
        {
          "id": "betteR.sessionInfo",
          "name": "Session",
          "icon": "$(info)",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "betteR.env.showHidden",
          "when": "false"
        },
        {
          "command": "betteR.env.hideHidden",
          "when": "false"
        },
        {
          "command": "betteR.env.remove",
          "when": "false"
        },
        {
          "command": "betteR.env.print",
          "when": "false"
        },
        {
          "command": "betteR.env.str",
          "when": "false"
        },
        {
          "command": "betteR.env.copy",
          "when": "false"
        },
        {
          "command": "betteR.env.viewData",
          "when": "false"
        },
        {
          "command": "betteR.env.clearFilter",
          "when": "betteR.envFiltered"
        }
      ],
      "view/title": [
        {
          "command": "betteR.env.filter",
          "when": "view == betteR.environment",
          "group": "navigation@0"
        },
        {
          "command": "betteR.env.clearFilter",
          "when": "view == betteR.environment && betteR.envFiltered",
          "group": "navigation@1"
        },
        {
          "command": "betteR.env.showHidden",
          "when": "view == betteR.environment && !betteR.showHidden",
          "group": "navigation@2"
        },
        {
          "command": "betteR.env.hideHidden",
          "when": "view == betteR.environment && betteR.showHidden",
          "group": "navigation@2"
        },
        {
          "command": "betteR.env.clear",
          "when": "view == betteR.environment",
          "group": "navigation@3"
        },
        {
          "command": "betteR.env.refresh",
          "when": "view =~ /^betteR\\./",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "betteR.env.viewData",
          "when": "viewItem =~ /VariableTable$/",
          "group": "inline@0"
        },
        {
          "command": "betteR.env.viewData",
          "when": "viewItem =~ /VariableTable$/",
          "group": "0_view@1"
        },
        {
          "command": "betteR.env.print",
          "when": "viewItem =~ /^rTopVariable/ || viewItem == rSearchObject",
          "group": "inline@1"
        },
        {
          "command": "betteR.env.remove",
          "when": "viewItem =~ /^rTopVariable/",
          "group": "inline@2"
        },
        {
          "command": "betteR.env.print",
          "when": "viewItem =~ /^rTopVariable/ || viewItem == rSearchObject",
          "group": "1_run@1"
        },
        {
          "command": "betteR.env.str",
          "when": "viewItem =~ /^rTopVariable/ || viewItem == rSearchObject",
          "group": "1_run@2"
        },
        {
          "command": "betteR.env.copy",
          "when": "viewItem =~ /^r[A-Z]/",
          "group": "2_copy@1"
        },
        {
          "command": "betteR.env.remove",
          "when": "viewItem =~ /^rTopVariable/",
          "group": "3_remove@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "npm run compile && vsce package -o better-vscode.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
  }
}
