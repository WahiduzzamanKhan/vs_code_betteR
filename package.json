{
  "name": "better-vscode",
  "displayName": "betteR",
  "description": "One live R session (ark) shared by the terminal console, the editor, the debugger and a plot pane. No R packages installed into your project.",
  "version": "0.2.0",
  "publisher": "better",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WahiduzzamanKhan/vs_code_betteR.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:r"
  ],
  "contributes": {
    "commands": [
      {
        "command": "betteR.openConsole",
        "title": "Open R Console",
        "category": "betteR"
      },
      {
        "command": "betteR.showPlots",
        "title": "Show Plots",
        "category": "betteR"
      },
      {
        "command": "betteR.clearPlots",
        "title": "Clear All Plots",
        "category": "betteR"
      },
      {
        "command": "betteR.showViewer",
        "title": "Show Viewer",
        "category": "betteR"
      },
      {
        "command": "betteR.helpAtCursor",
        "title": "Help for Symbol at Cursor",
        "category": "betteR"
      },
      {
        "command": "betteR.runSelection",
        "title": "Run Selection or Line in R Console",
        "category": "betteR"
      },
      {
        "command": "betteR.restart",
        "title": "Restart R Session",
        "category": "betteR"
      },
      {
        "command": "betteR.env.refresh",
        "title": "Refresh R Environment",
        "category": "betteR",
        "icon": "$(refresh)"
      },
      {
        "command": "betteR.env.clear",
        "title": "Clear R Environment",
        "category": "betteR",
        "icon": "$(clear-all)"
      },
      {
        "command": "betteR.env.filter",
        "title": "Filter Objects by Name",
        "category": "betteR",
        "icon": "$(search)"
      },
      {
        "command": "betteR.env.clearFilter",
        "title": "Clear Filter",
        "category": "betteR",
        "icon": "$(search-stop)"
      },
      {
        "command": "betteR.env.showHidden",
        "title": "Show Hidden Objects",
        "category": "betteR",
        "icon": "$(eye)"
      },
      {
        "command": "betteR.env.hideHidden",
        "title": "Hide Hidden Objects",
        "category": "betteR",
        "icon": "$(eye-closed)"
      },
      {
        "command": "betteR.env.remove",
        "title": "Remove Object",
        "category": "betteR",
        "icon": "$(trash)"
      },
      {
        "command": "betteR.env.viewData",
        "title": "View Data",
        "category": "betteR",
        "icon": "$(table)"
      },
      {
        "command": "betteR.env.print",
        "title": "Print in Console",
        "category": "betteR",
        "icon": "$(play)"
      },
      {
        "command": "betteR.env.str",
        "title": "Show Structure (str) in Console",
        "category": "betteR"
      },
      {
        "command": "betteR.env.copy",
        "title": "Copy",
        "category": "betteR"
      }
    ],
    "keybindings": [
      {
        "command": "betteR.runSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == r"
      },
      {
        "command": "betteR.helpAtCursor",
        "key": "f1",
        "when": "editorTextFocus && editorLangId == r"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "shift+enter",
        "args": {
          "text": "\u001b\r"
        },
        "when": "terminalFocus && betteR.consoleShiftEnter && !config.terminal.integrated.enableKittyKeyboardProtocol"
      },
      {
        "command": "betteR.env.filter",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "focusedView == betteR.environment"
      }
    ],
    "configuration": {
      "title": "betteR",
      "properties": {
        "betteR.arkPath": {
          "type": "string",
          "default": "",
          "description": "Optional: a separate ark binary to run R instead of the kernel built into `better`. Leave empty to use the built-in kernel."
        },
        "betteR.consolePath": {
          "type": "string",
          "default": "",
          "description": "Path to the better binary (console and built-in R kernel); `better.exe` on Windows. Empty: `better` (`better.exe` on Windows) on PATH, then ../betteR/target/debug/better."
        },
        "betteR.openConsoleOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Open the R console in a terminal when the session starts."
        }
      }
    },
    "debuggers": [
      {
        "type": "ark",
        "label": "R (ark)",
        "languages": [
          "r"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "r"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "betteR",
          "title": "R Session",
          "icon": "$(symbol-variable)"
        }
      ]
    },
    "views": {
      "betteR": [
        {
          "id": "betteR.environment",
          "name": "Environment",
          "icon": "$(symbol-variable)"
        },
        {
          "id": "betteR.searchPath",
          "name": "Attached",
          "icon": "$(package)"
        },
        {
          "id": "betteR.namespaces",
          "name": "Loaded Namespaces",
          "icon": "$(library)",
          "visibility": "collapsed"
        },
        {
          "id": "betteR.sessionInfo",
          "name": "Session",
          "icon": "$(info)",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "betteR.env.showHidden",
          "when": "false"
        },
        {
          "command": "betteR.env.hideHidden",
          "when": "false"
        },
        {
          "command": "betteR.env.remove",
          "when": "false"
        },
        {
          "command": "betteR.env.print",
          "when": "false"
        },
        {
          "command": "betteR.env.str",
          "when": "false"
        },
        {
          "command": "betteR.env.copy",
          "when": "false"
        },
        {
          "command": "betteR.env.viewData",
          "when": "false"
        },
        {
          "command": "betteR.env.clearFilter",
          "when": "betteR.envFiltered"
        }
      ],
      "view/title": [
        {
          "command": "betteR.env.filter",
          "when": "view == betteR.environment",
          "group": "navigation@0"
        },
        {
          "command": "betteR.env.clearFilter",
          "when": "view == betteR.environment && betteR.envFiltered",
          "group": "navigation@1"
        },
        {
          "command": "betteR.env.showHidden",
          "when": "view == betteR.environment && !betteR.showHidden",
          "group": "navigation@2"
        },
        {
          "command": "betteR.env.hideHidden",
          "when": "view == betteR.environment && betteR.showHidden",
          "group": "navigation@2"
        },
        {
          "command": "betteR.env.clear",
          "when": "view == betteR.environment",
          "group": "navigation@3"
        },
        {
          "command": "betteR.env.refresh",
          "when": "view =~ /^betteR\\./",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "betteR.env.viewData",
          "when": "viewItem =~ /VariableTable$/",
          "group": "inline@0"
        },
        {
          "command": "betteR.env.viewData",
          "when": "viewItem =~ /VariableTable$/",
          "group": "0_view@1"
        },
        {
          "command": "betteR.env.print",
          "when": "viewItem =~ /^rTopVariable/ || viewItem == rSearchObject",
          "group": "inline@1"
        },
        {
          "command": "betteR.env.remove",
          "when": "viewItem =~ /^rTopVariable/",
          "group": "inline@2"
        },
        {
          "command": "betteR.env.print",
          "when": "viewItem =~ /^rTopVariable/ || viewItem == rSearchObject",
          "group": "1_run@1"
        },
        {
          "command": "betteR.env.str",
          "when": "viewItem =~ /^rTopVariable/ || viewItem == rSearchObject",
          "group": "1_run@2"
        },
        {
          "command": "betteR.env.copy",
          "when": "viewItem =~ /^r[A-Z]/",
          "group": "2_copy@1"
        },
        {
          "command": "betteR.env.remove",
          "when": "viewItem =~ /^rTopVariable/",
          "group": "3_remove@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "npm run compile && vsce package -o better-vscode.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
  }
}
